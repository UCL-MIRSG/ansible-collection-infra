{#
  Alertmanager configuration, assembled as a data structure and serialised with
  to_nice_yaml

  The default policy configuration is in roles/monitoring_server/defaults/main.yml
  (monitoring_server_alert_tiers, ..._alertmanager_alert_groups,
  ..._alertmanager_inhibit_rules).
#}

{#
  Note the Go template references, resolved by Alertmanager when it sends a notification.
  These are Jinja *string literals*: Jinja does not evaluate the {{ }} inside a
  quoted string, so they need neither {% raw %} nor !unsafe.
#}

{% set notifications_enabled = monitoring_server_smtp_enabled or monitoring_server_slack_enabled %}

{% set slack_fields = {
     'color': '{{ template "slack.color" . }}',
     'title': '{{ template "slack.title" . }}',
     'text': '{{ template "slack.text" . }}',
   } %}

{% set severity_routes = [] %}

{% for tier in monitoring_server_alert_tiers %}
{%   set _ = severity_routes.append({
       'matchers': ['severity="' ~ tier.name ~ '"'],
       'receiver': tier.receiver,
       'group_wait': tier.group_wait,
       'group_interval': tier.group_interval,
       'repeat_interval': tier.repeat_interval,
     }) %}
{% endfor %}

{% set routes = [] %}

{% if notifications_enabled %}
{%   for group in monitoring_server_alertmanager_alert_groups %}
{%     set matcher = {'matchers': ['alertname=~"' ~ group.alertnames | join('|') ~ '"']}
         if group.alertnames | default([]) else {} %}
{%     set _ = routes.append(matcher | combine({
         'group_by': group.group_by,
         'receiver': 'null',
         'routes': severity_routes,
       })) %}
{%   endfor %}
{% endif %}

{#
  Severity-based inhibition rules

  `monitoring_server_alert_tiers` is ordered most to least-severe, so each tier
  inhibits every tier below it. `inhibit_equal` says what identifies one
  occurrence of a group's problem, and defaults to that group's `group_by`
  without `severity`. The rules compares alerts *across* severities, so keying
  on it would stop every rule matching.

  Each ruleset is restricted to its own family of alertnames.
#}

{% set tier_names = monitoring_server_alert_tiers | map(attribute='name') | list %}

{% set claimed_alertnames = [] %}
{% for group in monitoring_server_alertmanager_alert_groups %}
{%   set _ = claimed_alertnames.extend(group.alertnames | default([])) %}
{% endfor %}

{% set inhibit_rules = [] %}

{% for group in monitoring_server_alertmanager_alert_groups %}
{%   if group.alertnames | default([]) %}
{%     set family = ['alertname=~"' ~ group.alertnames | join('|') ~ '"'] %}
{%   elif claimed_alertnames %}
{%     set family = ['alertname!~"' ~ claimed_alertnames | join('|') ~ '"'] %}
{%   else %}
{%     set family = [] %}
{%   endif %}
{%   set equal = group.inhibit_equal
       | default(group.group_by | reject('equalto', 'severity') | list) %}
{%   for index in range(tier_names | length - 1) %}
{%     set _ = inhibit_rules.append({
         'source_matchers': ['severity="' ~ tier_names[index] ~ '"'] + family,
         'target_matchers': ['severity=~"' ~ tier_names[index + 1:] | join('|') ~ '"'] + family,
         'equal': equal,
       }) %}
{%   endfor %}
{% endfor %}

{# Cross-cutting rules are not per-family, so they are defined directly in the
Ansible variables. #}

{% set _ = inhibit_rules.extend(monitoring_server_alertmanager_inhibit_rules) %}

{% set receivers = [{'name': 'null'}] %}

{% if notifications_enabled %}
{%   for tier in monitoring_server_alert_tiers %}
{%     set receiver = {'name': tier.receiver} %}
{%     if monitoring_server_smtp_enabled and (tier.email or (tier.email_fallback and not monitoring_server_slack_enabled)) %}
{%       set _ = receiver.update({'email_configs': [{
           'to': monitoring_server_notification_email,
           'send_resolved': tier.send_resolved,
         }]}) %}
{%     endif %}

{%     if monitoring_server_slack_enabled and tier.slack %}
{%       set _ = receiver.update({'slack_configs': [{
           'api_url': monitoring_server_slack_webhook_url,
           'channel': monitoring_server_slack_channel,
           'send_resolved': tier.send_resolved,
           'color': slack_fields.color,
           'title': slack_fields.title,
           'text': slack_fields.text,
           'actions': [
             {
               'type': 'button',
               'text': 'Query :mag:',
               'url': '{{ (index .Alerts 0).GeneratorURL }}',
             },
             {
               'type': 'button',
               'text': 'Silence :no_bell:',
               'url': '{{ template "__alert_silence_link" . }}',
             },
           ],
         }]}) %}
{%     endif %}
{%     set _ = receivers.append(receiver) %}
{%   endfor %}
{% endif %}

{#
  Root route. Every alert is claimed by one of the groups above, which set their
  own grouping and timings, so these values only apply if that list is emptied.
  Anything reaching them goes to the 'null' receiver and is dropped.
#}
{% set route = {
     'group_by': ['alertname', 'instance'],
     'group_wait': '30s',
     'group_interval': '5m',
     'repeat_interval': '4h',
     'receiver': 'null',
   } %}

{% if routes %}
{%   set _ = route.update({'routes': routes}) %}
{% endif %}

{% if monitoring_server_smtp_enabled %}
{%   set global_config = {
       'smtp_smarthost': monitoring_server_smtp_hostname ~ ':' ~ monitoring_server_smtp_port,
       'smtp_from': monitoring_server_admin_email,
       'smtp_auth_username': monitoring_server_smtp_username,
       'smtp_auth_password': monitoring_server_smtp_password,
       'smtp_require_tls': monitoring_server_smtp_start_tls,
     } %}
{% else %}
{%   set global_config = none %}
{% endif %}

{% set config = {
     'global': global_config,
     'templates': [monitoring_server_alertmanager.volume ~ '/template/*.tmpl'],
     'route': route,
     'inhibit_rules': inhibit_rules,
     'receivers': receivers,
   } %}

# Managed by Ansible - do not edit on the host, changes will be overwritten.
{{ config | to_nice_yaml(indent=2, sort_keys=false) }}
