{#
  Alertmanager configuration, assembled as a data structure and serialised with
  to_nice_yaml

  The default policy configuration is in roles/monitoring_server/defaults/main.yml
  (monitoring_server_alert_tiers, ..._inhibit_rules, ..._group_by).
#}

{#
  Note the Go template references, resolved by Alertmanager when it sends a notification.
  These are Jinja *string literals*: Jinja does not evaluate the {{ }} inside a
  quoted string, so they need neither {% raw %} nor !unsafe.
#}

{% set notifications_enabled = monitoring_server_smtp_enabled or monitoring_server_slack_enabled %}

{% set slack_fields = {
     'color': '{{ template "slack.color" . }}',
     'title': '{{ template "slack.title" . }}',
     'text': '{{ template "slack.text" . }}',
   } %}

{% set filesystem_severity_routes = [] %}
{% set default_severity_routes = [] %}

{% for tier in monitoring_server_alert_tiers %}
{%   for target in [filesystem_severity_routes, default_severity_routes] %}
{%     set _ = target.append({
         'matchers': ['severity="' ~ tier.name ~ '"'],
         'receiver': tier.receiver,
         'group_wait': tier.group_wait,
         'group_interval': tier.group_interval,
         'repeat_interval': tier.repeat_interval,
       }) %}
{%   endfor %}
{% endfor %}

{% set routes = [] %}

{% if notifications_enabled %}
{%   set _ = routes.append({
       'matchers': ['alertname=~"' ~ monitoring_server_alertmanager_filesystem_alertnames ~ '"'],
       'group_by': monitoring_server_alertmanager_filesystem_group_by,
       'receiver': 'null',
       'routes': filesystem_severity_routes,
     }) %}
{%   set _ = routes.extend(default_severity_routes) %}
{% endif %}

{% set receivers = [{'name': 'null'}] %}

{% if notifications_enabled %}
{%   for tier in monitoring_server_alert_tiers %}
{%     set receiver = {'name': tier.receiver} %}
{%     if monitoring_server_smtp_enabled and (tier.email or (tier.email_fallback and not monitoring_server_slack_enabled)) %}
{%       set _ = receiver.update({'email_configs': [{
           'to': monitoring_server_notification_email,
           'send_resolved': tier.send_resolved,
         }]}) %}
{%     endif %}

{%     if monitoring_server_slack_enabled and tier.slack %}
{%       set _ = receiver.update({'slack_configs': [{
           'api_url': monitoring_server_slack_webhook_url,
           'channel': monitoring_server_slack_channel,
           'send_resolved': tier.send_resolved,
           'color': slack_fields.color,
           'title': slack_fields.title,
           'text': slack_fields.text,
           'actions': [
             {
               'type': 'button',
               'text': 'Query :mag:',
               'url': '{{ (index .Alerts 0).GeneratorURL }}',
             },
             {
               'type': 'button',
               'text': 'Silence :no_bell:',
               'url': '{{ template "__alert_silence_link" . }}',
             },
           ],
         }]}) %}
{%     endif %}
{%     set _ = receivers.append(receiver) %}
{%   endfor %}
{% endif %}

{#
  Root route. These timings are the fallback for anything matching no child
  route, which goes to the 'null' receiver and is dropped, so they are not
  tunable policy and stay here rather than in defaults.
#}
{% set route = {
     'group_by': monitoring_server_alertmanager_group_by,
     'group_wait': '30s',
     'group_interval': '5m',
     'repeat_interval': '4h',
     'receiver': 'null',
   } %}

{% if routes %}
{%   set _ = route.update({'routes': routes}) %}
{% endif %}

{% if monitoring_server_smtp_enabled %}
{%   set global_config = {
       'smtp_smarthost': monitoring_server_smtp_hostname ~ ':' ~ monitoring_server_smtp_port,
       'smtp_from': monitoring_server_admin_email,
       'smtp_auth_username': monitoring_server_smtp_username,
       'smtp_auth_password': monitoring_server_smtp_password,
       'smtp_require_tls': monitoring_server_smtp_start_tls,
     } %}
{% else %}
{%   set global_config = none %}
{% endif %}

{% set config = {
     'global': global_config,
     'templates': [monitoring_server_alertmanager.volume ~ '/template/*.tmpl'],
     'route': route,
     'inhibit_rules': monitoring_server_alertmanager_inhibit_rules,
     'receivers': receivers,
   } %}

# Managed by Ansible - do not edit on the host, changes will be overwritten.
{{ config | to_nice_yaml(indent=2, sort_keys=false) }}
