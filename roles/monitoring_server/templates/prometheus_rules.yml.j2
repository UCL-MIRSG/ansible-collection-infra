groups:
  - name: tls-expiry
    rules:
      # Escalating windows on the same condition; Alertmanager inhibition
      # (equal: instance) ensures only the most-severe firing window notifies.
      - alert: SSLCertExpiringSoon
        expr: probe_ssl_earliest_cert_expiry - time() < 60 * 60 * 24 * 21
        for: 1h
        labels:
          severity: info
          host: '{{ reReplaceAll ":[0-9]+$" "" (reReplaceAll "^https?://" "" $labels.instance) }}'
        annotations:
          summary: "TLS certificate expiring soon (instance {{ $labels.instance }})"
          description: "TLS certificate will expire in {{ $value | humanizeDuration }} (instance {{ $labels.instance }})"

      - alert: SSLCertExpiringSoon
        expr: probe_ssl_earliest_cert_expiry - time() < 60 * 60 * 24 * 7
        for: 1h
        labels:
          severity: warning
          host: '{{ reReplaceAll ":[0-9]+$" "" (reReplaceAll "^https?://" "" $labels.instance) }}'
        annotations:
          summary: "TLS certificate expiring soon (instance {{ $labels.instance }})"
          description: "TLS certificate will expire in {{ $value | humanizeDuration }} (instance {{ $labels.instance }})"

      - alert: SSLCertExpiringSoon
        expr: probe_ssl_earliest_cert_expiry - time() < 60 * 60 * 24 * 2
        for: 1m
        labels:
          severity: critical
          host: '{{ reReplaceAll ":[0-9]+$" "" (reReplaceAll "^https?://" "" $labels.instance) }}'
        annotations:
          summary: "TLS certificate expiring imminently (instance {{ $labels.instance }})"
          description: "TLS certificate will expire in {{ $value | humanizeDuration }} (instance {{ $labels.instance }})"

  - name: down-detector
    rules:
      - alert: EndpointDown
        expr: probe_success == 0
        for: 5m
        labels:
          severity: critical
          host: '{{ reReplaceAll ":[0-9]+$" "" (reReplaceAll "^https?://" "" $labels.instance) }}'
        annotations:
          summary: "Endpoint {{ $labels.instance }} down"

      - alert: InstanceDown
        expr: up == 0
        for: 5m
        labels:
          severity: critical
          host: '{{ reReplaceAll ":[0-9]+$" "" (reReplaceAll "^https?://" "" $labels.instance) }}'
        annotations:
          summary: "{{ $labels.job }} instance {{ $labels.instance }} down"
          description: "{{ $labels.instance }} of job {{ $labels.job }} has been down for more than 5 minutes."

  - name: metrics
    rules:
      # `keep_firing_for` on the resource alerts below stops a brief gap in
      # scraped data - e.g. from a slow or failed scrape - from resolving an alert whose
      # condition is still true, only for it to re-fire minutes later.
      - alert: MemoryUsageHigh
        expr: 100- node_memory_MemAvailable_bytes/node_memory_MemTotal_bytes*100 > 90
        for: 5m
        keep_firing_for: 15m
        labels:
          severity: warning
          host: '{{ reReplaceAll ":[0-9]+$" "" (reReplaceAll "^https?://" "" $labels.instance) }}'
        annotations:
          summary: Instance memory usage high (Instance:{{ $labels.instance }})
          description: "Instance memory usage more than 90% within 5 minutes, value:{{ printf \"%.2f\" $value }}%"

      - alert: CpuLoadHigh
        expr: 100 - avg by(instance)(rate(node_cpu_seconds_total{mode="idle"}[10m]))*100 > 90
        for: 15m
        keep_firing_for: 15m
        labels:
          severity: warning
          host: '{{ reReplaceAll ":[0-9]+$" "" (reReplaceAll "^https?://" "" $labels.instance) }}'
        annotations:
          summary: Instance cpu load high (Instance:{{ $labels.instance }})
          description: "Instance cpu load more than 90% within 10 minutes, value: {{ printf \"%.2f\" $value }}%"

      # 30m averaging prevents threshold flapping and bridges staleness during scrape drops.
      # Uses `avail` instead of `free` to exclude root-reserved blocks (reflects true
      # usable capacity). Do not revert to `free`.
      # `summary` uses only shared labels because this alert groups multiple hosts.
      - alert: FilesystemFull
        expr: >-
          100 - avg_over_time(node_filesystem_avail_bytes{mountpoint!~"/|/boot.*|/run.*"}[30m])
          / avg_over_time(node_filesystem_size_bytes[30m]) * 100 > 90
        for: 15m
        keep_firing_for: 1h
        labels:
          severity: warning
          host: '{{ reReplaceAll ":[0-9]+$" "" (reReplaceAll "^https?://" "" $labels.instance) }}'
        annotations:
          summary: "Filestore {{ $labels.mountpoint }} disk space low"
          description: "{{ $labels.instance }}: {{ $labels.mountpoint }} is {{ printf \"%.2f\" $value }}% used (threshold 90%)"

      - alert: FilesystemFull
        expr: >-
          100 - avg_over_time(node_filesystem_avail_bytes{mountpoint!~"/|/boot.*|/run.*"}[30m])
          / avg_over_time(node_filesystem_size_bytes[30m]) * 100 > 97
        for: 15m
        keep_firing_for: 1h
        labels:
          severity: critical
          host: '{{ reReplaceAll ":[0-9]+$" "" (reReplaceAll "^https?://" "" $labels.instance) }}'
        annotations:
          summary: "Filestore {{ $labels.mountpoint }} almost full"
          description: "{{ $labels.instance }}: {{ $labels.mountpoint }} is {{ printf \"%.2f\" $value }}% used (threshold 97%)"

      - alert: InodeUsageHigh
        expr: >-
          100 - avg_over_time(node_filesystem_files_free[30m])
          / avg_over_time(node_filesystem_files[30m]) * 100 > 90
        for: 15m
        keep_firing_for: 1h
        labels:
          severity: warning
          host: '{{ reReplaceAll ":[0-9]+$" "" (reReplaceAll "^https?://" "" $labels.instance) }}'
        annotations:
          summary: "Filestore {{ $labels.mountpoint }} inode usage high"
          description: "{{ $labels.instance }}: {{ $labels.mountpoint }} has used {{ printf \"%.2f\" $value }}% of its file nodes (inodes) (threshold 90%)"
