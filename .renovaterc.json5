{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>UCL-MIRSG/.github//renovate/default-config.json5"],
  "ansible-galaxy": {
    description: "Ansible dependencies in galaxy.yml and the Molecule lock file",
    managerFilePatterns: [
      "/^galaxy\\.yml$/",
      "/^molecule_configs\\/requirements\\.yml$/",
    ],
  },
  packageRules: [
    {
      description: "community.general >=12.0 needs ansible-core >=2.17. The limits in these rules keep dependencies compatible with ansible-core 2.16 (the last release supporting Python 2.7 on EL7 and Python 3.6 on EL8 hosts) and must match those in galaxy.yml",
      matchManagers: ["ansible-galaxy"],
      matchPackageNames: ["community.general"],
      allowedVersions: "<12.0.0",
    },
    {
      description: "community.crypto >=3.0 needs Python >=3.7 and ansible-core >=2.17",
      matchManagers: ["ansible-galaxy"],
      matchPackageNames: ["community.crypto"],
      allowedVersions: "<3.0.0",
    },
    {
      description: "community.postgresql >=5.0 needs Python 3, and 4.2.0 breaks idempotency, so keep to 3.x for EL7 (Python 2.7)",
      matchManagers: ["ansible-galaxy"],
      matchPackageNames: ["community.postgresql"],
      allowedVersions: "<4.0.0",
    },
    {
      description: "Only allow major updates of ansible.posix and community.docker once they are confirmed to work with ansible-core 2.16",
      matchManagers: ["ansible-galaxy"],
      matchPackageNames: ["ansible.posix", "community.docker"],
      matchUpdateTypes: ["major"],
      enabled: false,
    },
    {
      description: "Keep default XNAT version to 1.9.x",
      matchPackageNames: ["NrgXnat/xnat"],
      allowedVersions: "<1.10",
    },
    {
      description: "Keep the default Pipeline Engine version compatible with XNAT 1.9",
      matchPackageNames: ["NrgXnat/xnat-pipeline-engine"],
      allowedVersions: "<1.9.0",
    },
    {
      description: "Keep the default Pipeline Engine plugin compatible with XNAT 1.9",
      matchPackageNames: ["NrgXnat/pipeline-engine-plugin"],
      allowedVersions: "<1.3.0",
    },
    {
      description: "Keep the default OHIF plugin version compatible with XNAT 1.9",
      matchPackageNames: ["xnatworks/ohif-viewer-xnat-plugin"],
      allowedVersions: "<3.8.0",
    },
    {
      description: "Keep the default batch-launch plugin version compatible with XNAT 1.9",
      matchPackageNames: ["NrgXnat/batch-launch-plugin"],
      allowedVersions: "<0.9.0",
    },
  ],
  customManagers: [
    {
      customType: "regex",
      description: "Update Tomcat version",
      managerFilePatterns: [
        "/playbooks/group_vars/xnat.yml$/",
        "/roles/tomcat/defaults/main.yml$/",
      ],
      matchStrings: ["tomcat_version:\\s?(?<currentValue>.*?)\\n"],
      depNameTemplate: "org.apache.tomcat:tomcat",
      datasourceTemplate: "maven",
    },
    {
      customType: "regex",
      description: "Update XNAT version specified in roles/xnat/defaults/main.yml",
      managerFilePatterns: ["/(^|/)*defaults/main.yml$/"],
      matchStrings: ["xnat_version:\\s?(?<currentValue>.*?)\\n"],
      // XNAT releases moved from Bitbucket (xnatdev/xnat-web) to the
      // NrgXnat/xnat monorepo on GitHub; the WAR is a GitHub release asset.
      depNameTemplate: "NrgXnat/xnat",
      datasourceTemplate: "github-releases",
    },
    {
      customType: "regex",
      description: "Update XNAT-sync plugin version specified in roles/xnat/defaults/main.yml",
      managerFilePatterns: ["/roles/xnat/defaults/main.yml$/"],
      matchStrings: ["xsync-plugin-all-(?<currentValue>.*?).jar"],
      depNameTemplate: "NrgXnat/xsync",
      datasourceTemplate: "github-releases",
    },
    {
      customType: "regex",
      description: "Update XNAT ldap-auth plugin version specified in roles/xnat/defaults/main.yml",
      managerFilePatterns: ["/roles/xnat/defaults/main.yml$/"],
      matchStrings: ["ldap-auth-plugin-(?<currentValue>.*?).jar"],
      depNameTemplate: "NrgXnat/ldap-auth-plugin",
      datasourceTemplate: "github-releases",
    },
    {
      customType: "regex",
      description: "Update XNAT openid-auth plugin version specified in roles/xnat/defaults/main.yml",
      managerFilePatterns: ["/roles/xnat/defaults/main.yml$/"],
      matchStrings: ["openid-auth-plugin-(?<currentValue>.*?).jar"],
      depNameTemplate: "xnatx/openid-auth-plugin",
      datasourceTemplate: "bitbucket-tags",
    },
    {
      customType: "regex",
      description: "Update OHIF Viewer plugin version specified in roles/xnat/defaults/main.yml",
      managerFilePatterns: ["/roles/xnat/defaults/main.yml$/"],
      matchStrings: ["ohif-viewer-(?<currentValue>.*?).jar"],
      depNameTemplate: "xnatworks/ohif-viewer-xnat-plugin",
      datasourceTemplate: "github-releases",
    },
    {
      customType: "regex",
      description: "Update XNAT ML plugin version specified in roles/xnat/defaults/main.yml",
      managerFilePatterns: ["/roles/xnat/defaults/main.yml$/"],
      matchStrings: ["ml-plugin-(?<currentValue>.*?).jar"],
      depNameTemplate: "xnatx/ml-plugin",
      datasourceTemplate: "bitbucket-tags",
    },
    {
      customType: "regex",
      description: "Update XNAT datasets plugin version specified in roles/xnat/defaults/main.yml",
      managerFilePatterns: ["/roles/xnat/defaults/main.yml$/"],
      matchStrings: ["datasets-plugin-(?<currentValue>.*?).jar"],
      depNameTemplate: "xnatx/datasets-plugin",
      datasourceTemplate: "bitbucket-tags",
    },
    {
      customType: "regex",
      description: "Update XNAT image viewer plugin version specified in roles/xnat/defaults/main.yml",
      managerFilePatterns: ["/roles/xnat/defaults/main.yml$/"],
      matchStrings: ["ximgview-plugin(?<currentValue>.*?).jar"],
      depNameTemplate: "xnatdev/xnat-image-viewer-plugin",
      datasourceTemplate: "bitbucket-tags",
    },
    {
      customType: "regex",
      description: "Update XNAT dxm plugin version specified in roles/xnat/defaults/main.yml",
      managerFilePatterns: ["/roles/xnat/defaults/main.yml$/"],
      matchStrings: ["dxm-settings-plugin-(?<currentValue>.*?).jar"],
      depNameTemplate: "NrgXnat/dxm-settings-plugin",
      datasourceTemplate: "github-releases",
    },
    {
      customType: "regex",
      description: "Update XNAT pipeline engine UI plugin version specified in roles/xnat/defaults/main.yml",
      managerFilePatterns: ["/roles/xnat/defaults/main.yml$/"],
      matchStrings: ["pipeline_engine_ui-(?<currentValue>.*?)-xpl.jar"],
      depNameTemplate: "NrgXnat/pipeline-engine-plugin",
      datasourceTemplate: "github-releases",
    },
    {
      customType: "regex",
      description: "Update XNAT pipeline version specified in roles/xnat/defaults/main.yml",
      managerFilePatterns: ["/(^|/)*defaults/main.yml$/"],
      matchStrings: ["xnat_pipeline_version:\\s?(?<currentValue>.*?)\\n"],
      depNameTemplate: "NrgXnat/xnat-pipeline-engine",
      datasourceTemplate: "github-releases",
    },
    {
      customType: "regex",
      description: "Update XNAT Container Service plugin version used for testing with molecule",
      managerFilePatterns: [
        "/playbooks/molecule/resources/xnat/inventory/group_vars/all/server.yml$/",
      ],
      matchStrings: ["container-service-(?<currentValue>.*?)-fat.jar"],
      depNameTemplate: "NrgXnat/container-service",
      datasourceTemplate: "github-releases",
    },
    {
      customType: "regex",
      description: "Update XNAT batch launch plugin version used for testing with molecule",
      managerFilePatterns: [
        "/playbooks/molecule/resources/xnat/inventory/group_vars/all/server.yml$/",
      ],
      matchStrings: ["batch-launch-(?<currentValue>.*?)-xpl.jar"],
      depNameTemplate: "NrgXnat/batch-launch-plugin",
      datasourceTemplate: "github-releases",
    },
    {
      customType: "regex",
      description: "Update XNAT dax plugin used for testing with molecule",
      managerFilePatterns: [
        "/playbooks/molecule/resources/xnat/inventory/group_vars/all/server.yml$/",
      ],
      matchStrings: ["dax-plugin-genProcData-(?<currentValue>.*?).jar"],
      depNameTemplate: "VUIIS/dax",
      datasourceTemplate: "custom.VUIIS-dax",
    },
  ],
}
